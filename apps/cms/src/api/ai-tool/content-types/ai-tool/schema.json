{
  "kind": "collectionType",
  "collectionName": "ai_tools",
  "info": {
    "singularName": "ai-tool",
    "pluralName": "ai-tools",
    "displayName": "AI Tool",
    "description": "A curated AI tool listing"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "longDescription": {
      "type": "richtext"
    },
    "websiteUrl": {
      "type": "string",
      "required": true
    },
    "pricingModel": {
      "type": "enumeration",
      "enum": ["free", "freemium", "paid", "enterprise"],
      "required": true
    },
    "pricingSummary": {
      "type": "text"
    },
    "startingPrice": {
      "type": "string"
    },
    "billingPeriod": {
      "type": "string"
    },
    "freeTierAvailable": {
      "type": "boolean",
      "default": false
    },
    "pricingNotes": {
      "type": "text"
    },
    "pricingDefaultTab": {
      "type": "string"
    },
    "pricingTabs": {
      "type": "json"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "pros": {
      "type": "json"
    },
    "cons": {
      "type": "json"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo"
    }
  }
}
