---
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@jelajahai/config";
import { ui } from "@jelajahai/ui";

type JsonLdValue = Record<string, unknown> | Record<string, unknown>[];

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  jsonLd?: JsonLdValue;
};

const {
  title = siteConfig.name,
  description = siteConfig.description,
  canonical = siteConfig.siteUrl,
  robots = "index,follow",
  jsonLd
} = Astro.props as Props;

const pageSchema =
  jsonLd ?? {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonical
  };
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0b1020" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/jelajahAI-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <ClientRouter />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      const theme = storedTheme ?? "dark";
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
        <img class="brand-logo" src="/jelajahAI-logo.png" alt="JelajahAI" />
        <span class="brand-lockup">
          <span class="brand-name">{siteConfig.name}</span>
          <span class="brand-slogan">Unlock AI Knowledge</span>
        </span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        {siteConfig.navigation.map((item) => (
          <a class={ui.pillLink} href={item.href}>
            {item.label}
          </a>
        ))}
      </nav>
      <button
        id="theme-toggle"
        class={`${ui.buttonSecondary} theme-toggle`}
        type="button"
        aria-label="Toggle color theme"
      >
        <span aria-hidden="true">&#9681;</span>
        <span class="theme-label">Theme</span>
      </button>
    </header>
    <slot />
    <script is:inline>
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = nextTheme;
        document.documentElement.style.colorScheme = nextTheme;
        localStorage.setItem("theme", nextTheme);
      });
    </script>
    <script>
      import { newsletterService } from "../lib/services/newsletter-service";

      const form = document.getElementById("newsletter-form");
      const input = document.getElementById("newsletter-email");
      const status = document.getElementById("newsletter-status");
      const button = form?.querySelector("button[type='submit']");

      if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement) || !status || !(button instanceof HTMLButtonElement)) {
        throw new Error("Newsletter UI elements are missing");
      }

      if (!newsletterService.isConfigured()) {
        button.disabled = true;
        input.disabled = true;
        status.textContent = "Newsletter signup is available when PUBLIC_API_URL is configured.";
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!newsletterService.isConfigured()) {
          return;
        }

        const email = input.value.trim();

        if (!email) {
          status.textContent = "Please enter a valid email address.";
          return;
        }

        button.disabled = true;
        status.textContent = "Subscribing...";

        try {
          const result = await newsletterService.subscribe(email);
          status.textContent = result.message;
          input.value = "";
        } catch (error) {
          const message = error instanceof Error ? error.message : "Subscription failed.";
          status.textContent = message;
        } finally {
          button.disabled = !newsletterService.isConfigured();
        }
      });
    </script>
  </body>
</html>

<style>
  :global(html) { overflow-x: hidden; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: var(--page-bg);
    color: var(--text-main);
    font-family: "Manrope", "Avenir Next", sans-serif;
    overflow-x: hidden;
  }

  :global(body)::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.3;
    background-image: linear-gradient(rgba(151, 177, 255, 0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(151, 177, 255, 0.055) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: linear-gradient(to bottom, black, transparent 62%);
  }

  .site-header {
    box-sizing: border-box;
    width: min(1120px, calc(100% - 2rem));
    margin: 0.6rem auto 0;
    padding: .8rem .9rem .8rem 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    position: relative;
    z-index: 5;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: var(--header-bg);
    backdrop-filter: blur(22px);
    box-shadow: 0 1.2rem 3rem rgba(2, 6, 23, 0.2), inset 0 1px rgba(255,255,255,.06);
  }

  .site-nav {
    display: flex;
    gap: 0.75rem;
    margin-left: auto;
    flex-wrap: wrap;
    min-width: 0;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.35rem;
    padding: 0 .85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.035);
    color: var(--text-main);
    text-decoration: none;
    font-weight: 700;
  }

  .brand,
  .theme-toggle {
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 13rem;
    color: var(--text-main);
  }

  .brand-logo {
    display: block;
    width: auto;
    height: 2.3rem;
    max-width: 4.5rem;
    object-fit: contain;
  }

  .brand-lockup {
    display: grid;
    gap: 0.18rem;
  }

  .brand-name {
    font-size: 1.04rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .brand-slogan {
    color: #91a7ff;
    font: 0.55rem/1.2 "DM Mono", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .theme-toggle {
    padding: .68rem .85rem;
    border: 1px solid var(--border);
    color: var(--text-main);
    background: rgba(255,255,255,.05);
    cursor: pointer;
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
  }

  .theme-toggle span:first-child { color: #8ea4ff; font-size: 1.1rem; }

  .skip-link {
    position: fixed;
    left: 1rem;
    top: -5rem;
    z-index: 20;
    padding: 0.75rem 1rem;
    border-radius: 0.7rem;
    background: var(--accent);
    color: var(--accent-text);
  }

  .skip-link:focus { top: 1rem; }

  .ui-pill-link,
  .ui-button,
  .ui-button--secondary,
  .ui-button--primary,
  .ui-card,
  .ui-input {
    box-sizing: border-box;
  }

  .site-footer {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0 0 4rem;
  }

  .newsletter-card {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
    padding: 1.8rem;
    border-radius: 1.5rem;
    border: 1px solid var(--border);
    background: radial-gradient(circle at 85% 0%, rgba(100, 123, 255, .17), transparent 34%), linear-gradient(145deg, var(--surface-strong), var(--surface));
    box-shadow: inset 0 1px rgba(255,255,255,.06), 0 1.5rem 3.5rem rgba(2,6,23,.18);
  }

  .newsletter-copy .eyebrow {
    margin: 0 0 1rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8ea4ff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .newsletter-copy h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
  }

  .newsletter-copy p {
    margin: 0.75rem 0 0;
    color: var(--text-subtle);
    line-height: 1.7;
  }

  .newsletter-form {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .newsletter-form input {
    width: 100%;
    min-height: 3rem;
    padding: 0 1rem;
    border-radius: 0.9rem;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.06);
    color: var(--text-main);
  }

  .newsletter-form button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    width: fit-content;
    padding: 0 1rem;
    border-radius: 999px;
    border: 0;
    background: linear-gradient(135deg, #aeb7ff, #6d9eff 55%, #62dded);
    color: var(--accent-text);
    font-weight: 700;
    cursor: pointer;
  }

  .newsletter-status {
    margin: 0;
    min-height: 1.5rem;
    color: var(--text-subtle);
  }

  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible),
  :global([tabindex="0"]:focus-visible) {
    outline: 3px solid #74e8ed;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px rgba(116, 232, 237, 0.2), 0 0 1.4rem rgba(116, 232, 237, 0.35);
  }

  :global(input:focus-visible) {
    border-color: #74e8ed;
  }

  :global(.search-input-wrap:focus-within) {
    border-color: #74e8ed;
    box-shadow: 0 0 0 4px rgba(116, 232, 237, 0.18), 0 0 1.4rem rgba(116, 232, 237, 0.28);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :global(main.page:not(.homepage)) {
    position: relative;
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3.2rem 0 6rem;
  }

  :global(main.page:not(.homepage))::before {
    content: "";
    position: absolute;
    width: 34rem;
    height: 18rem;
    top: -4rem;
    right: -15rem;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(81, 131, 255, 0.2), transparent 68%);
    filter: blur(16px);
  }

  :global(main.page:not(.homepage) .hero.compact) {
    position: relative;
    display: grid;
    align-content: end;
    min-height: 15rem;
    padding: 2.25rem 2rem 2.2rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: radial-gradient(circle at 88% 10%, rgba(99, 114, 255, 0.22), transparent 28%), linear-gradient(135deg, rgba(19, 34, 75, 0.75), rgba(7, 15, 34, 0.66));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), 0 1.6rem 3rem rgba(2, 7, 25, 0.16);
  }

  :global(main.page:not(.homepage) .hero.compact)::after {
    content: "";
    position: absolute;
    inset: auto 2rem 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(116, 232, 237, 0.5), transparent);
  }

  :global(main.page:not(.homepage) .hero.compact)::before {
    content: "01 / KNOWLEDGE SIGNAL";
    position: absolute;
    top: 1.2rem;
    right: 1.5rem;
    color: rgba(159, 246, 220, 0.7);
    font: 0.58rem "DM Mono", monospace;
    letter-spacing: 0.1em;
  }

  :global(main.page:not(.homepage) .hero.compact .eyebrow) {
    margin: 0 0 0.85rem;
    color: #9ff6dc;
    font: 0.65rem/1.4 "DM Mono", monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  :global(main.page:not(.homepage) .hero.compact h1) {
    max-width: 48rem;
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  :global(main.page:not(.homepage) .hero.compact .lede) {
    max-width: 44rem;
    margin: 1.1rem 0 0;
    color: var(--text-subtle);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  :global(main.page:not(.homepage) > section:not(.hero)) {
    margin-top: 2.4rem;
  }

  :global(main.page:not(.homepage) .section-head) {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  :global(main.page:not(.homepage) .section-head h2),
  :global(main.page:not(.homepage) .related > h2) {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2.3rem);
    letter-spacing: -0.06em;
  }

  :global(main.page:not(.homepage) .section-head a),
  :global(main.page:not(.homepage) .section-link) {
    color: #9db0ff;
    font: 0.65rem "DM Mono", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  :global(main.page:not(.homepage) .detail) {
    max-width: 62rem;
    padding-top: 1.5rem;
  }

  :global(main.page:not(.homepage) .detail > h1) {
    max-width: 56rem;
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  :global(main.page:not(.homepage) .panel),
  :global(main.page:not(.homepage) .table-shell),
  :global(main.page:not(.homepage) .search-shell) {
    border-color: rgba(157, 183, 255, 0.2);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.055), 0 1.2rem 2.4rem rgba(2, 7, 25, 0.12);
  }

  :global(main.page:not(.homepage) .panel h2),
  :global(main.page:not(.homepage) .panel h3) {
    color: var(--text-main);
    letter-spacing: -0.04em;
  }

  :global(main.page:not(.homepage) .panel p),
  :global(main.page:not(.homepage) .panel li),
  :global(main.page:not(.homepage) .panel dd),
  :global(main.page:not(.homepage) .related article p) {
    color: var(--text-subtle);
    line-height: 1.75;
  }

  :global(main.page:not(.homepage) .meta-links a),
  :global(main.page:not(.homepage) .button),
  :global(main.page:not(.homepage) .actions a) {
    border: 1px solid rgba(157, 183, 255, 0.25);
    background: rgba(255, 255, 255, 0.06);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  :global(main.page:not(.homepage) .meta-links a:hover),
  :global(main.page:not(.homepage) .button:hover),
  :global(main.page:not(.homepage) .actions a:hover) {
    transform: translateY(-2px);
    border-color: rgba(116, 232, 237, 0.6);
    background: rgba(94, 145, 255, 0.14);
  }

  :global(html[data-theme="dark"]) {
    color-scheme: dark;
    --page-bg: radial-gradient(circle at 50% -10%, rgba(72, 86, 203, .28), transparent 36%), radial-gradient(circle at 100% 40%, rgba(42, 184, 224, .08), transparent 25%), linear-gradient(180deg, #050815 0%, #070d1d 48%, #050815 100%);
    --text-main: #f4f7ff;
    --text-subtle: #a9b8d8;
    --surface: rgba(255, 255, 255, 0.05);
    --surface-strong: rgba(255, 255, 255, 0.08);
    --border: rgba(157, 183, 255, 0.16);
    --accent: #aeb7ff;
    --accent-text: #07101d;
    --glow: rgba(92, 126, 255, 0.22);
    --header-bg: rgba(6, 13, 32, .72);
  }

  :global(html[data-theme="light"]) {
    color-scheme: light;
    --page-bg: radial-gradient(circle at 50% -10%, rgba(103, 117, 255, .18), transparent 36%), linear-gradient(180deg, #f8fbff 0%, #edf3ff 100%);
    --text-main: #0d1628;
    --text-subtle: rgba(13, 22, 40, 0.72);
    --surface: rgba(255, 255, 255, 0.74);
    --surface-strong: rgba(255, 255, 255, 0.92);
    --border: rgba(13, 22, 40, 0.12);
    --accent: #172554;
    --accent-text: #f8fbff;
    --glow: rgba(79, 70, 229, 0.14);
    --header-bg: rgba(248, 251, 255, .82);
  }

  @media (max-width: 700px) {
    .site-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "brand theme" "nav nav";
      align-items: center;
      width: min(100% - 2rem, 40rem);
      margin-top: 0.75rem;
      padding: 1rem;
    }
    .brand { grid-area: brand; }
    .theme-toggle { grid-area: theme; }
    .site-nav {
      position: relative;
      grid-area: nav;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      margin-left: 0;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding: 0.25rem 0.1rem 0.2rem;
      scrollbar-color: #7f92e6 rgba(255,255,255,.06);
      scrollbar-width: thin;
    }
    .site-nav a { white-space: nowrap; }
    .theme-label { display: none; }
    .brand { min-width: 0; }
    .brand-logo { height: 2rem; max-width: 3.6rem; }
    .brand-slogan { font-size: 0.48rem; }
    :global(main.page:not(.homepage)) { width: min(100% - 2rem, 40rem); padding-top: 1.5rem; }
    :global(main.page:not(.homepage) .hero.compact) { min-height: 13rem; padding: 2.1rem 1.1rem 1.35rem; border-radius: 1.2rem; }
    :global(main.page:not(.homepage) .hero.compact)::before { top: 0.85rem; right: 1rem; font-size: 0.5rem; }
    :global(main.page:not(.homepage) .hero.compact)::after { inset: auto 1.1rem 0; }
    :global(main.page:not(.homepage) .hero.compact h1), :global(main.page:not(.homepage) .detail > h1) { font-size: clamp(2.45rem, 13vw, 4.2rem); }
    :global(main.page:not(.homepage) .section-head) { align-items: start; }
    :global(main.page:not(.homepage) > section:not(.hero)) { margin-top: 1.6rem; }
    .site-footer { padding-bottom: 2.5rem; }
    .newsletter-card { margin-top: 1.3rem; padding: 1.2rem; }
    .newsletter-copy h2 { font-size: 1.35rem; }
  }

  @media (max-width: 340px) {
    .site-nav::after {
      content: "→";
      position: absolute;
      top: 0.3rem;
      right: 0.15rem;
      display: grid;
      width: 1.7rem;
      height: 2.25rem;
      place-items: center;
      border-left: 1px solid rgba(157, 183, 255, 0.22);
      background: linear-gradient(90deg, rgba(6, 13, 32, 0), rgba(6, 13, 32, 0.95) 42%);
      color: #9ff6dc;
      font-size: 1rem;
      pointer-events: none;
    }
  }
</style>
