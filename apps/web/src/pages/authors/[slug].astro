---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentGrid from "../../components/ContentGrid.astro";
import { contentService } from "../../lib/services/content-service";
import { getAuthorCollections, getAuthors, toCard } from "../../lib/route-data";

export async function getStaticPaths() {
  const content = await contentService.getHomeContent();

  return getAuthors(content).map((author) => ({
    params: { slug: author.slug }
  }));
}

const content = await contentService.getHomeContent();
const author = getAuthors(content).find((entry) => entry.slug === Astro.params.slug);

if (!author) {
  throw new Error(`Missing author: ${Astro.params.slug}`);
}

const collections = getAuthorCollections(content, author.slug);
const sections = [
  {
    title: "Articles",
    path: "articles",
    items: collections.articles.map((entry) => toCard(entry))
  },
  {
    title: "Tutorials",
    path: "tutorials",
    items: collections.tutorials.map((entry) => toCard(entry))
  }
];
---

<BaseLayout
  title={`${author.name} | Authors | JelajahAI`}
  description={author.bio ?? `Browse content by ${author.name}.`}
  canonical={`https://jelajahai.dev/authors/${author.slug}/`}
>
  <main id="main-content" class="page">
    <section class="hero compact">
      <p class="eyebrow">Author</p>
      <h1>{author.name}</h1>
      <p class="lede">{author.bio}</p>
    </section>

    {sections.map((section) =>
      section.items.length > 0 ? (
        <section class="section-block">
          <div class="section-head">
            <h2>{section.title}</h2>
            <a href={`/${section.path}/`}>View all</a>
          </div>
          <ContentGrid items={section.items} kindLabel={section.title} pathSegment={section.path} />
        </section>
      ) : null
    )}
  </main>
</BaseLayout>

<style>
  .compact {
    padding-top: 2rem;
  }

  .section-block {
    margin-top: 2rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-head a {
    color: var(--text-subtle);
    text-decoration: none;
  }
</style>
