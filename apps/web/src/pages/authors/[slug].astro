---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentGrid from "../../components/ContentGrid.astro";
import { contentService } from "../../lib/services/content-service";
import { getAuthorCollections, getAuthors, toCard } from "../../lib/route-data";
const content = await contentService.getHomeContent();
const slug = Astro.params.slug ?? "";
const author = getAuthors(content).find((entry) => entry.slug === slug);

if (!author) {
  Astro.response.status = 404;
}

const collections = author ? getAuthorCollections(content, author.slug) : { articles: [], tutorials: [] };
const sections = [
  {
    title: "Articles",
    path: "articles",
    items: collections.articles.map((entry) => toCard(entry))
  },
  {
    title: "Tutorials",
    path: "tutorials",
    items: collections.tutorials.map((entry) => toCard(entry))
  }
];
const pageTitle = author ? `${author.name} | Authors | JelajahAI` : "Author not found | JelajahAI";
const pageDescription = author ? author.bio ?? `Browse content by ${author.name}.` : "The author you requested could not be found.";
const pageCanonical = author ? `https://jelajahai.dev/authors/${author.slug}/` : `https://jelajahai.dev/authors/${slug}/`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
>
  <main id="main-content" class="page">
    {author ? (
      <>
        <section class="hero compact">
          <p class="eyebrow">Author</p>
          <h1>{author.name}</h1>
          <p class="lede">{author.bio}</p>
        </section>

        {sections.map((section) =>
          section.items.length > 0 ? (
            <section class="section-block">
              <div class="section-head">
                <h2>{section.title}</h2>
                <a href={`/${section.path}/`}>View all</a>
              </div>
              <ContentGrid items={section.items} kindLabel={section.title} pathSegment={section.path} />
            </section>
          ) : null
        )}
      </>
    ) : (
      <section class="hero compact">
        <p class="eyebrow">Not found</p>
        <h1>Author not found</h1>
        <p class="lede">The author may have been removed or the URL is outdated.</p>
        <div class="actions">
          <a href="/authors/">Browse authors</a>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .compact {
    padding-top: 2rem;
  }

  .section-block {
    margin-top: 2rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-head a {
    color: var(--text-subtle);
    text-decoration: none;
  }
</style>
