---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentGrid from "../../components/ContentGrid.astro";
import { contentService } from "../../lib/services/content-service";
import {
  getCategories,
  getCategoryCollections,
  toCard
} from "../../lib/route-data";
const content = await contentService.getHomeContent();
const slug = Astro.params.slug ?? "";
const category = getCategories(content).find((entry) => entry.slug === slug);

if (!category) {
  Astro.response.status = 404;
}

const collections = category
  ? getCategoryCollections(content, category.slug)
  : { articles: [], tools: [], prompts: [], tutorials: [] };
const sections = [
  {
    title: "Articles",
    path: "articles",
    items: collections.articles.map((entry) => toCard(entry))
  },
  {
    title: "Tools",
    path: "tools",
    items: collections.tools.map((entry) => toCard(entry))
  },
  {
    title: "Prompts",
    path: "prompts",
    items: collections.prompts.map((entry) => toCard(entry))
  },
  {
    title: "Tutorials",
    path: "tutorials",
    items: collections.tutorials.map((entry) => toCard(entry))
  }
];
const pageTitle = category ? `${category.name} | Categories | JelajahAI` : "Category not found | JelajahAI";
const pageDescription = category ? category.description ?? `Browse content in ${category.name}.` : "The category you requested could not be found.";
const pageCanonical = category ? `https://jelajahai.dev/categories/${category.slug}/` : `https://jelajahai.dev/categories/${slug}/`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
>
  <main id="main-content" class="page">
    {category ? (
      <>
        <section class="hero compact">
          <p class="eyebrow">Category</p>
          <h1>{category.name}</h1>
          <p class="lede">{category.description}</p>
        </section>

        {sections.map((section) =>
          section.items.length > 0 ? (
            <section class="section-block">
              <div class="section-head">
                <h2>{section.title}</h2>
                <a href={`/${section.path}/`}>View all</a>
              </div>
              <ContentGrid items={section.items} kindLabel={section.title} pathSegment={section.path} />
            </section>
          ) : null
        )}
      </>
    ) : (
      <section class="hero compact">
        <p class="eyebrow">Not found</p>
        <h1>Category not found</h1>
        <p class="lede">The category may have been removed or the URL is outdated.</p>
        <div class="actions">
          <a href="/categories/">Browse categories</a>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .compact {
    padding-top: 2rem;
  }

  .section-block {
    margin-top: 2rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-head a {
    color: var(--text-subtle);
    text-decoration: none;
  }
</style>
