---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroIllustration from "../assets/hero-illustration.png";
import { contentService } from "../lib/services/content-service";

const homeContent = await contentService.getHomeContent();

const articles = homeContent.articles;
const featuredArticle = articles[0];
const gridArticles = articles.slice(1, 7);

const featuredTools = homeContent.tools.slice(0, 1);
const featuredPrompts = homeContent.prompts.slice(0, 1);
const featuredTutorials = homeContent.tutorials.slice(0, 1);
const featuredModels = homeContent.models.slice(0, 2);
const totalSignals = homeContent.articles.length + homeContent.tools.length + homeContent.prompts.length + homeContent.tutorials.length + homeContent.models.length;
---

<BaseLayout
  title={`${homeContent.siteSettings.siteTitle} | AI Knowledge Hub`}
  description={homeContent.siteSettings.tagline ?? "Browse AI articles, tools, prompts, tutorials, and models in one curated hub."}
>
  <main id="main-content" class="page homepage">
    <div class="page-orbit page-orbit--one" aria-hidden="true"></div>
    <div class="page-orbit page-orbit--two" aria-hidden="true"></div>

    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow"><span class="pulse"></span> {homeContent.siteSettings.siteTitle} <span class="eyebrow-divider">/</span> signal library</p>
        <h1 id="hero-heading">Find the <em>signal</em> in artificial intelligence.</h1>
        <p class="lede">
          {homeContent.siteSettings.tagline ?? "A living field guide to the tools, ideas, and workflows shaping what comes next."}
        </p>
        <div class="actions">
          <a class="action-primary" href="#content">Start exploring <span aria-hidden="true">&#8594;</span></a>
          <a class="action-secondary" href="/search/">Search the library <span aria-hidden="true">/</span><kbd>K</kbd></a>
        </div>
        <div class="hero-proof">
          <span class="avatar-stack" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Curated for curious builders</span>
          <span class="proof-line" aria-hidden="true"></span>
          <span><span class="proof-dot"></span>Updated weekly</span>
        </div>
      </div>

      <div class="hero-art" aria-label="JelajahAI signal instrument">
        <div class="hero-art-glow" aria-hidden="true"></div>
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="orbit orbit--one" aria-hidden="true"><span></span></div>
        <div class="orbit orbit--two" aria-hidden="true"><span></span></div>
        <div class="signal-node signal-node--one" aria-hidden="true"></div>
        <div class="signal-node signal-node--two" aria-hidden="true"></div>
        <div class="signal-node signal-node--three" aria-hidden="true"></div>
        <div class="hero-frame">
          <Image
            src={heroIllustration}
            alt=""
            width={1536}
            height={1024}
            loading="eager"
            quality={90}
            class="hero-image"
          />
          <span class="image-scanline" aria-hidden="true"></span>
        </div>
        <div class="live-index" aria-hidden="true"><span class="pulse"></span> LIVE INDEX <strong>04:28</strong></div>
        <div class="hero-readout" aria-hidden="true">
          <span class="readout-label">signal / 001</span>
          <span class="readout-value">+{totalSignals || 0}</span>
          <span class="readout-caption">indexed references</span>
        </div>
      </div>
    </section>

    <section class="signal-index" aria-labelledby="index-heading">
      <div class="index-heading">
        <p class="eyebrow">01 / The index</p>
        <h2 id="index-heading">A small library with a wide point of view.</h2>
      </div>
      <div class="stats-grid">
        <div class="stat-card stat-card--violet"><span class="stat-value">{homeContent.articles.length.toString().padStart(2, "0")}</span><span class="stat-label">Articles</span></div>
        <div class="stat-card stat-card--cyan"><span class="stat-value">{homeContent.tools.length.toString().padStart(2, "0")}</span><span class="stat-label">Tools</span></div>
        <div class="stat-card stat-card--mint"><span class="stat-value">{homeContent.prompts.length.toString().padStart(2, "0")}</span><span class="stat-label">Prompts</span></div>
        <div class="stat-card stat-card--apricot"><span class="stat-value">{homeContent.tutorials.length.toString().padStart(2, "0")}</span><span class="stat-label">Tutorials</span></div>
      </div>
    </section>

    <section class="library-section" id="content" aria-labelledby="library-heading">
      <div class="section-intro">
        <div>
          <p class="eyebrow">02 / The library</p>
          <h2 id="library-heading">Useful things,<br /><em>beautifully organized.</em></h2>
        </div>
        <div class="section-intro-copy">
          <span class="signal-chip"><span class="signal-chip-dot"></span> {totalSignals || 0} signals indexed</span>
          <p>Practical context for navigating the fast-moving AI landscape. No hype cycle required.</p>
        </div>
      </div>

      {/* Featured Article Section */}
      {featuredArticle && (
        <div class="featured-article-container">
          <article class="featured-article-card">
            <div class="featured-article-copy">
              <p class="article-topic">{featuredArticle.category?.name ?? "Topic"}</p>
              <div class="article-topic-line"></div>
              <h3>
                <a href={`/articles/${featuredArticle.slug}`}>{featuredArticle.title}</a>
              </h3>
              <p class="excerpt">{featuredArticle.excerpt}</p>
            </div>
            {featuredArticle.coverImage && (
              <div class="featured-article-visual">
                <div class="featured-badge">FEATURED</div>
                <img
                  src={featuredArticle.coverImage.url}
                  alt={featuredArticle.coverImage.alt ?? ""}
                  class="featured-article-img"
                  loading="eager"
                />
              </div>
            )}
          </article>
        </div>
      )}

      {/* Horizontal Divider Line */}
      <hr class="articles-separator" />

      {/* Grid of Articles */}
      <div class="articles-grid-container">
        {gridArticles.map((article) => (
          <article class="article-grid-card">
            <p class="article-topic">{article.category?.name ?? "Topic"}</p>
            <div class="article-topic-line"></div>
            
            {article.coverImage && (
              <div class="article-card-visual">
                <img
                  src={article.coverImage.url}
                  alt={article.coverImage.alt ?? ""}
                  class="article-card-img"
                  loading="lazy"
                />
              </div>
            )}
            
            <h3>
              <a href={`/articles/${article.slug}`}>{article.title}</a>
            </h3>
            {!article.coverImage && <p class="excerpt">{article.excerpt}</p>}
          </article>
        ))}
      </div>

      {/* Secondary Resources Section */}
      <div class="resources-section-divider"></div>
      <div class="resources-grid">
        {featuredTools.map((tool) => (
          <article class="content-card content-card--tool">
            <div class="card-topline"><span class="card-index">T / 01</span><span class="card-kind">Tool</span><span class="card-arrow" aria-hidden="true">&#8599;</span></div>
            <h3><a href={`/tools/${tool.slug}`}>{tool.name}</a></h3>
            <p>{tool.shortDescription}</p>
            <span class="card-footer">Inspect tool <span aria-hidden="true">&#8594;</span></span>
          </article>
        ))}
        {featuredPrompts.map((prompt) => (
          <article class="content-card content-card--prompt">
            <div class="card-topline"><span class="card-index">P / 01</span><span class="card-kind">Prompt</span><span class="card-arrow" aria-hidden="true">&#8599;</span></div>
            <h3><a href={`/prompts/${prompt.slug}`}>{prompt.title}</a></h3>
            <p>{prompt.useCaseDescription}</p>
            <span class="card-footer">Open prompt <span aria-hidden="true">&#8594;</span></span>
          </article>
        ))}
        {featuredTutorials.map((tutorial) => (
          <article class="content-card content-card--tutorial">
            <div class="card-topline"><span class="card-index">L / 01</span><span class="card-kind">Tutorial</span><span class="card-arrow" aria-hidden="true">&#8599;</span></div>
            <h3><a href={`/tutorials/${tutorial.slug}`}>{tutorial.title}</a></h3>
            <p>{tutorial.excerpt ?? "A practical learning path for building with AI."}</p>
            <span class="card-footer">Follow the path <span aria-hidden="true">&#8594;</span></span>
          </article>
        ))}
      </div>
    </section>

    <section class="feature-strip" aria-label="Platform highlights">
      <div class="feature-lead"><span class="feature-number">01</span><strong>Fast search</strong><span>Client-side Fuse.js search across every content type.</span><span class="feature-mark" aria-hidden="true">&#8599;</span></div>
      <div><span class="feature-number">02</span><strong>SEO ready</strong><span>Metadata, sitemap, RSS, robots, and JSON-LD-friendly structure.</span></div>
      <div><span class="feature-number">03</span><strong>Accessible by default</strong><span>Mobile-first layouts, semantic markup, and keyboard-friendly controls.</span></div>
    </section>

    <section class="hub-links" aria-label="Browse by taxonomy">
      <a href="/categories/"><span class="taxonomy-number">A1</span><strong>Categories</strong><span>Organized by major content buckets.</span><span class="taxonomy-arrow" aria-hidden="true">&#8599;</span></a>
      <a href="/tags/"><span class="taxonomy-number">B2</span><strong>Tags</strong><span>Discover cross-cutting topics and workflows.</span><span class="taxonomy-arrow" aria-hidden="true">&#8599;</span></a>
      <a href="/authors/"><span class="taxonomy-number">C3</span><strong>Authors</strong><span>Follow the people behind the content.</span><span class="taxonomy-arrow" aria-hidden="true">&#8599;</span></a>
    </section>

    <section class="model-panel" aria-labelledby="models-heading">
      <div class="section-head">
        <div><p class="eyebrow">03 / Models</p><h2 id="models-heading">A clearer view of the model layer.</h2></div>
        <a class="section-link" href="/models/compare/">Compare models <span aria-hidden="true">&#8599;</span></a>
      </div>
      <p class="model-intro">Reference pages with pricing, capability notes, and the context to choose well.</p>
      <div class="model-grid">
        {featuredModels.map((model, index) => (
          <article class="model-card">
            <div class="model-card-top"><span class:list={["model-orb", index === 0 ? "model-orb--blue" : "model-orb--violet"]} aria-hidden="true"></span><span class="model-status">AVAILABLE</span><span class="card-arrow" aria-hidden="true">&#8599;</span></div>
            <h3><a href={`/models/${model.slug}`}>{model.name}</a></h3>
            <p>{model.description ?? "Model reference and capability notes."}</p>
            <dl><div><dt>Vendor</dt><dd>{model.vendor}</dd></div><div><dt>Context</dt><dd>{model.contextWindow ?? "Reference"}</dd></div></dl>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(html) { font-family: "Manrope", "Avenir Next", sans-serif; }
  :global(body) { position: relative; }
  :global(body)::after { content: ""; position: fixed; inset: 0; z-index: 10; pointer-events: none; opacity: .06; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.38'/%3E%3C/svg%3E"); }
  .page { position: relative; width: min(1160px, calc(100% - 2rem)); margin: 0 auto; padding: 3.5rem 0 7rem; overflow: hidden; }
  .page-orbit { position: absolute; border: 1px solid rgba(101, 139, 255, .12); border-radius: 50%; pointer-events: none; }
  .page-orbit--one { width: 44rem; height: 19rem; right: -18rem; top: 7rem; transform: rotate(-24deg); }
  .page-orbit--two { width: 52rem; height: 22rem; left: -31rem; top: 29rem; transform: rotate(18deg); border-color: rgba(75, 224, 255, .09); }
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; min-height: 37rem; padding: 3.5rem 0 5rem; }
  .hero-copy { position: relative; z-index: 1; max-width: 34rem; }
  .eyebrow, .card-topline, .model-status, .stat-label, .readout-label, .readout-caption, .signal-chip, .feature-number, .taxonomy-number { font-family: "DM Mono", monospace; text-transform: uppercase; letter-spacing: .13em; }
  .eyebrow { margin: 0 0 1.25rem; color: #91a7ff; font-size: .7rem; line-height: 1.4; }
  .eyebrow-divider { margin: 0 .5rem; color: rgba(168, 185, 218, .38); }
  .pulse, .proof-dot { display: inline-block; width: .44rem; height: .44rem; margin-right: .3rem; border-radius: 50%; background: #78f0d0; box-shadow: 0 0 .85rem #78f0d0; }
  h1 { margin: 0; max-width: 38rem; color: var(--text-main); font-size: clamp(3.25rem, 7vw, 6.8rem); line-height: .91; letter-spacing: -.075em; text-wrap: balance; }
  h1 em { color: #aab3ff; font-style: italic; font-weight: 500; text-shadow: 0 0 2.5rem rgba(113, 127, 255, .6); }
  .lede { max-width: 30rem; margin: 1.6rem 0 0; color: var(--text-subtle); font-size: 1.05rem; line-height: 1.75; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .actions a { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.15rem; border-radius: .8rem; text-decoration: none; font-weight: 800; transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease; }
  .actions a:hover, .section-link:hover, .hub-links a:hover { transform: translateY(-3px); }
  .action-primary { color: #07101d; background: linear-gradient(135deg, #aeb7ff, #6d9eff 55%, #62dded); box-shadow: 0 1rem 2.5rem rgba(77, 117, 255, .28); }
  .action-primary span { margin-left: .65rem; font-size: 1.15rem; }
  .action-secondary { color: var(--text-main); border: 1px solid var(--border); background: rgba(255,255,255,.06); }
  .action-secondary span { margin-left: .75rem; color: var(--text-subtle); font: .8rem "DM Mono", monospace; }
  kbd { margin-left: .25rem; padding: .12rem .35rem; border: 1px solid var(--border); border-radius: .3rem; color: var(--text-subtle); font: .65rem "DM Mono", monospace; }
  .hero-proof { display: flex; align-items: center; flex-wrap: wrap; gap: .65rem; margin-top: 2.1rem; color: var(--text-subtle); font: .62rem "DM Mono", monospace; letter-spacing: .05em; text-transform: uppercase; }
  .avatar-stack { display: inline-flex; padding-right: .3rem; }
  .avatar-stack i { width: 1.4rem; height: 1.4rem; margin-right: -.3rem; border: 2px solid #081128; border-radius: 50%; background: linear-gradient(145deg,#9fb8ff,#30458e); }
  .avatar-stack i:nth-child(2) { background: linear-gradient(145deg,#ffc27e,#9162a0); }
  .avatar-stack i:nth-child(3) { background: linear-gradient(145deg,#bde8e3,#3775a0); }
  .proof-line { width: 1.8rem; height: 1px; background: var(--border); }
  .proof-dot { width: .32rem; height: .32rem; margin-right: .35rem; }
  .hero-art { position: relative; justify-self: end; width: min(100%, 640px); min-height: 30rem; }
  .hero-art-glow { position: absolute; inset: 5% 4%; border-radius: 2rem; background: radial-gradient(circle at 50% 45%, rgba(71, 105, 255, .4), transparent 58%), radial-gradient(circle at 75% 75%, rgba(64, 226, 239, .2), transparent 36%); filter: blur(24px); }
  .hero-grid { position: absolute; inset: 2rem 0; border: 1px solid rgba(116, 151, 255, .18); border-radius: 1.8rem; background-image: linear-gradient(rgba(133, 165, 255, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(133, 165, 255, .06) 1px, transparent 1px); background-size: 2.5rem 2.5rem; transform: perspective(700px) rotateX(58deg) rotateZ(-5deg) scale(1.08); mask-image: linear-gradient(to bottom, transparent, black 25%, black 70%, transparent); }
  .hero-frame { position: absolute; inset: 1.3rem 0 1.5rem; z-index: 1; padding: .45rem; border: 1px solid rgba(157, 184, 255, .42); border-radius: 1.8rem; background: linear-gradient(135deg, rgba(125, 145, 255, .75), rgba(70, 219, 239, .45) 32%, rgba(255,255,255,.1) 62%, rgba(104, 99, 255, .65)); box-shadow: 0 2rem 5rem rgba(2, 9, 38, .58), 0 0 0 1px rgba(73, 224, 255, .18), 0 0 3.5rem rgba(78, 117, 255, .3); animation: float-in 900ms ease both; }
  .hero-image { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 1.4rem; filter: saturate(1.05) contrast(1.03); }
  .image-scanline { position: absolute; inset: 0; border-radius: 1.4rem; background: linear-gradient(180deg, transparent 10%, rgba(137, 225, 255, .14) 50%, transparent 90%); opacity: .55; animation: scan 5s ease-in-out infinite; pointer-events: none; }
  .live-index, .hero-readout { position: absolute; z-index: 2; border: 1px solid rgba(158, 183, 255, .32); background: rgba(7, 15, 41, .77); backdrop-filter: blur(16px); box-shadow: 0 .8rem 2rem rgba(3, 8, 27, .24); }
  .live-index { top: 0; right: 2rem; padding: .6rem .75rem; border-radius: .7rem; color: #9ff6dc; font: .61rem "DM Mono", monospace; letter-spacing: .1em; }
  .live-index .pulse { width: .35rem; height: .35rem; }
  .live-index strong { margin-left: .65rem; color: #b2bfdc; font-weight: 400; }
  .hero-readout { left: -1.5rem; bottom: .2rem; display: grid; gap: .18rem; min-width: 8rem; padding: .8rem .9rem; border-radius: .85rem; }
  .readout-label, .readout-caption { color: #83a0d2; font-size: .58rem; }
  .readout-value { color: #f5f7ff; font: 1.75rem "DM Mono", monospace; letter-spacing: -.08em; }
  .orbit { position: absolute; z-index: 2; border: 1px solid rgba(101, 217, 255, .35); border-left-color: transparent; border-radius: 50%; pointer-events: none; }
  .orbit--one { width: 9rem; height: 4rem; right: -2rem; top: 8rem; transform: rotate(35deg); }
  .orbit--two { width: 15rem; height: 5rem; left: -3.5rem; bottom: 6rem; border-color: rgba(154, 129, 255, .38); border-right-color: transparent; transform: rotate(-22deg); }
  .orbit span, .signal-node { position: absolute; width: .48rem; height: .48rem; border-radius: 50%; background: #7de5ff; box-shadow: 0 0 1rem #6fe7ff; }
  .orbit--one span { right: 1.2rem; top: .3rem; }.orbit--two span { left: 1.7rem; bottom: -.2rem; background: #b59bff; box-shadow: 0 0 1rem #a17eff; }
  .signal-node--one { right: 2.5rem; top: 4.5rem; }.signal-node--two { left: -1rem; top: 12rem; background: #ffc27e; box-shadow: 0 0 1rem #ffc27e; }.signal-node--three { right: 2rem; bottom: 2.5rem; background: #9cffdc; box-shadow: 0 0 1rem #9cffdc; }
  .signal-index { position: relative; display: grid; grid-template-columns: minmax(220px, .75fr) 1.25fr; gap: 2rem; align-items: end; padding: 1.4rem 0 1.25rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .index-heading h2 { max-width: 22rem; margin: 0; font-size: clamp(1.5rem, 3vw, 2.35rem); line-height: 1; letter-spacing: -.06em; }
  .index-heading .eyebrow { margin-bottom: .65rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .65rem; }
  .stat-card { position: relative; display: flex; flex-direction: column; justify-content: space-between; min-height: 5.5rem; padding: .8rem; overflow: hidden; border: 1px solid var(--border); border-radius: .85rem; background: rgba(255,255,255,.035); }
  .stat-card::after { content: ""; position: absolute; width: 3rem; height: 3rem; right: -.7rem; bottom: -1.2rem; border-radius: 50%; filter: blur(16px); opacity: .65; }.stat-card--violet::after { background: #7c83ff; }.stat-card--cyan::after { background: #55d8ff; }.stat-card--mint::after { background: #74f0cb; }.stat-card--apricot::after { background: #ffc27e; }
  .stat-value { position: relative; z-index: 1; color: var(--text-main); font: 1.55rem "DM Mono", monospace; letter-spacing: -.08em; }.stat-label { position: relative; z-index: 1; color: var(--text-subtle); font-size: .58rem; }
  .library-section { position: relative; padding-top: 6rem; }
  .section-intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }.section-intro h2 { margin: 0; font-size: clamp(2.2rem, 5vw, 4rem); line-height: .94; letter-spacing: -.075em; }.section-intro h2 em { color: #8e9cff; font-style: italic; font-weight: 500; }.section-intro .eyebrow { margin-bottom: .85rem; }.section-intro-copy { max-width: 18rem; }.section-intro-copy p { margin: 1rem 0 0; color: var(--text-subtle); line-height: 1.65; }.signal-chip { display: inline-flex; align-items: center; gap: .35rem; color: #9ff6dc; font-size: .58rem; }.signal-chip-dot { width: .35rem; height: .35rem; border-radius: 50%; background: #74f0cb; box-shadow: 0 0 .7rem #74f0cb; }
  .library-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(13rem, auto); gap: .8rem; margin-top: 2.5rem; }.content-card { position: relative; display: flex; min-height: 13rem; flex-direction: column; padding: 1.2rem; overflow: hidden; border: 1px solid var(--border); border-radius: 1.15rem; background: linear-gradient(145deg, rgba(255,255,255,.075), rgba(255,255,255,.025)); backdrop-filter: blur(14px); transition: transform 180ms ease, border-color 180ms ease, background 180ms ease; }.content-card::before { content: ""; position: absolute; inset: 0; opacity: 0; background: radial-gradient(circle at 20% 0%, rgba(133, 143, 255, .22), transparent 45%); transition: opacity 180ms ease; pointer-events: none; }.content-card:hover { transform: translateY(-5px); border-color: rgba(148, 176, 255, .44); background: linear-gradient(145deg, rgba(90, 115, 255, .13), rgba(255,255,255,.04)); }.content-card:hover::before { opacity: 1; }.content-card--feature { grid-column: span 2; grid-row: span 2; justify-content: end; min-height: 27rem; padding: 1.5rem; background: radial-gradient(circle at 80% 15%, rgba(93, 219, 255, .2), transparent 32%), linear-gradient(145deg, rgba(98, 108, 255, .22), rgba(255,255,255,.035)); }.content-card--tool { background: linear-gradient(145deg, rgba(87, 226, 222, .12), rgba(255,255,255,.035)); }.content-card--prompt { background: linear-gradient(145deg, rgba(158, 117, 255, .16), rgba(255,255,255,.035)); }.content-card--tutorial { background: linear-gradient(145deg, rgba(255, 188, 121, .12), rgba(255,255,255,.035)); }
  .card-topline { position: relative; z-index: 1; display: flex; align-items: center; gap: .6rem; color: var(--text-subtle); font-size: .58rem; }.card-kind { color: #aab6d6; }.card-arrow { margin-left: auto; color: #9db0ff; font-size: 1.15rem; }.card-index { color: #7e93bd; }.content-card h3 { position: relative; z-index: 1; max-width: 28rem; margin: auto 0 .75rem; color: var(--text-main); font-size: clamp(1.35rem, 2.5vw, 2.2rem); line-height: 1.02; letter-spacing: -.055em; }.content-card--article h3, .content-card--tool h3, .content-card--prompt h3, .content-card--tutorial h3 { margin-top: 2rem; font-size: 1.45rem; }.content-card p { position: relative; z-index: 1; max-width: 34rem; margin: 0; color: var(--text-subtle); line-height: 1.6; }.card-footer { position: relative; z-index: 1; margin-top: 1.4rem; color: #aebaff; font: .62rem "DM Mono", monospace; text-transform: uppercase; letter-spacing: .1em; }.card-footer span { margin-left: .45rem; }
