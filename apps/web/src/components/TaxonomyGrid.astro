---
interface Item {
  title: string;
  slug: string;
  description: string;
  count: number;
}

interface Props {
  items: Item[];
  basePath: string;
}

const { items, basePath } = Astro.props as Props;
---

<section class="grid" aria-label="Browse taxonomy">
  {items.map((item, index) => (
    <article>
      <div class="card-topline">
        <p class="card-kicker">{item.count} items</p>
        <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
        <span class="card-arrow" aria-hidden="true">↗</span>
      </div>
      <h2><a href={`/${basePath}/${item.slug}`}>{item.title}</a></h2>
      <p>{item.description}</p>
      <span class="card-cta">Explore topic <span aria-hidden="true">→</span></span>
    </article>
  ))}
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  article {
    position: relative;
    display: flex;
    min-height: 12rem;
    flex-direction: column;
    overflow: hidden;
    padding: 1.25rem;
    border-radius: 1.15rem;
    background: linear-gradient(145deg, rgba(255,255,255,.075), rgba(255,255,255,.025));
    border: 1px solid var(--border);
    backdrop-filter: blur(12px);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  article::after {
    content: "";
    position: absolute;
    width: 5rem;
    height: 5rem;
    right: -2rem;
    bottom: -2.5rem;
    border-radius: 50%;
    background: #55d8ff;
    filter: blur(24px);
    opacity: 0.18;
    pointer-events: none;
  }

  article:hover {
    transform: translateY(-4px);
    border-color: rgba(116, 232, 237, 0.48);
    background: linear-gradient(145deg, rgba(78, 113, 255, .16), rgba(255,255,255,.035));
  }

  .card-topline {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .card-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font: 0.66rem "DM Mono", monospace;
    color: #9ff6dc;
  }

  .card-index {
    color: #7e93bd;
    font: 0.58rem "DM Mono", monospace;
  }

  .card-arrow {
    margin-left: auto;
    color: #9db0ff;
    font-size: 1.1rem;
  }

  h2 {
    position: relative;
    z-index: 1;
    margin: auto 0 0.6rem;
    font-size: clamp(1.2rem, 2vw, 1.7rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
  }

  a {
    color: var(--text-main);
    text-decoration: none;
  }

  p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--text-subtle);
    line-height: 1.6;
  }

  .card-cta {
    position: relative;
    z-index: 1;
    display: block;
    margin-top: 1.15rem;
    color: #aebaff;
    font: 0.65rem "DM Mono", monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-cta span { margin-left: 0.35rem; font-size: 0.9rem; }

  @media (max-width: 800px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
